{
  "name": "dsh-plugin-bg-color",
  "version": "1.1.2",
  "private": true,
  "description": "Adjust the background color of the DSH window, surfaces, overlays, and sidebar from a floating panel, with curated light and dark combinations and immediate preview.",
  "type": "module",
  "keywords": ["dsh", "dsh-plugin", "theme", "background", "appearance"],
  "author": "fred.li",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg"],
  "engines": { "node": ">=20" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-theme"]
    }
  }
}
